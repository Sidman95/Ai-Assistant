# ============================================================
# Личный ассистент задач — конфигурация
# Скопируйте в .env и заполните:  cp .env.example .env
# ============================================================

# ---------- Telegram ----------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID (узнать: напишите боту @userinfobot). Бот отвечает ТОЛЬКО этому ID.
OWNER_TELEGRAM_ID=

# ---------- Yandex Cloud (основной ИИ-провайдер) ----------
# API-ключ сервисного аккаунта (роли: ai.languageModels.user, ai.speechkit-stt.user, ai.vision.user)
YC_API_KEY=
# Идентификатор каталога (folder id) в Yandex Cloud
YC_FOLDER_ID=

# ---------- LLM (OpenAI-совместимый интерфейс, NFR-2) ----------
# По умолчанию (пустые значения) используется YandexGPT:
#   base_url = https://llm.api.cloud.yandex.net/v1
#   model    = gpt://<YC_FOLDER_ID>/yandexgpt-lite/latest
#   api_key  = YC_API_KEY
# Для смены провайдера достаточно заполнить эти три переменные (код менять не нужно):
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat  LLM_API_KEY=sk-...
#   Ollama:   LLM_BASE_URL=http://ollama:11434/v1    LLM_MODEL=qwen2.5:7b     LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---------- STT (голос -> текст) и OCR (картинка -> текст) ----------
# yandex — Yandex SpeechKit / Yandex Vision OCR; disabled — отключить
STT_PROVIDER=yandex
OCR_PROVIDER=yandex

# ---------- Веб-кабинет ----------
# Логин/пароль создаются при первом запуске (потом пароль хранится только хэшем в БД)
WEB_USERNAME=admin
WEB_PASSWORD=
# Случайная строка для подписи сессионных cookie (сгенерировать: openssl rand -hex 32)
SECRET_KEY=

# ---------- Общие настройки ----------
# Часовой пояс по умолчанию (меняется потом в настройках)
TIMEZONE=Asia/Barnaul
# Домен для веб-кабинета (для TLS). Если домена нет — оставьте пустым и заходите по IP.
DOMAIN=

# ---------- Бэкап ----------
# Время суточного бэкапа (по часовому поясу TIMEZONE) и срок хранения копий
BACKUP_TIME=03:30
BACKUP_RETENTION_DAYS=14
