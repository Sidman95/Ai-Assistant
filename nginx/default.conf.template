# Базовый конфиг: HTTP. Если для домена ${DOMAIN} найден сертификат Let's Encrypt,
# скрипт 50-tls.sh добавит HTTPS-сервер (tls.conf) и включит редирект.

server {
    listen 80;
    server_name _;

    client_max_body_size 25m;

    # Для выпуска/продления сертификатов certbot (webroot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Включается только при наличии сертификата
    include /etc/nginx/conf.d/redirect-to-https[.]inc;

    location /api/ {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
    }
}
